# Copie para backend/.env e preencha. Sem DATABASE_URL, o backend usa SQLite local.

# Supabase / PostgreSQL — pegue em: Supabase > Project Settings > Database > Connection string (URI)
# Formato: postgresql://USER:PASSWORD@HOST:5432/postgres
# Dica: use a porta 6543 (pooler) se for fazer deploy serverless.
DATABASE_URL=

# Segurança
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS — origens do frontend Angular
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CORS_ALLOW_ALL=False
